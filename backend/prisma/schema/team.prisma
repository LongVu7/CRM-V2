// !--- Team models ---! //
model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?
  parentId    Int?     @map("parent_id")
  leaderId    Int?     @map("leader_id")
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  parent      Team?        @relation("TeamHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Team[]       @relation("TeamHierarchy")
  leader      Account?     @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  createdBy   Account?     @relation("TeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     TeamMember[]
  inquiries   Inquiry[]
  campaigns   Campaign[]

  @@index([parentId])
  @@index([leaderId])
  @@map("team")
}

model TeamMember {
  teamId    Int      @map("team_id")
  accountId Int      @unique @map("account_id")
  roleId    Int?     @map("role_id")
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@id([teamId, accountId])
  @@index([accountId])
  @@index([roleId])
  @@map("team_member")
}
