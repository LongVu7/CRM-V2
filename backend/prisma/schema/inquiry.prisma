// !--- Inquiry table ---! //
model Inquiry {
  id Int @id @default(autoincrement())

  assignedToId Int? @map("assigned_to_id")
  teamId       Int? @map("team_id")
  createdById  Int? @map("created_by_id")
 
  statusDataId Int?        @map("status_data_id")
  statusData   StatusData? @relation(fields: [statusDataId], references: [id])

  description String?

  dataReceived DateTime? @map("data_received") @db.Date

  sourceDataId Int?        @map("source_data_id")
  sourceData   SourceData? @relation(fields: [sourceDataId], references: [id])

  groupTele String? @map("group_tele") @db.VarChar(50)

  interactionAt      DateTime?           @map("interaction_at") @db.Timestamptz()
  callCount          Int?                @map("call_count")
  eventNames         EventName[]         @default([]) @map("event_names")
  callLog            String?             @map("call_log") @db.Text
  recordFile         String?             @map("record_file")
  compensationStatus CompensationStatus? @map("compensation_status")
  priority           Priority?           @map("priority")

  createDate DateTime? @map("create_date") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  firstProcessedAt  DateTime? @map("first_processed_at") @db.Timestamptz()
  firstInteractedAt DateTime? @map("first_interacted_at") @db.Timestamptz()
  nbAt              DateTime? @map("nb_at") @db.Timestamptz()

  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  assignedTo Account? @relation("InquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  Account? @relation("InquiryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  studentId Int?     @unique @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  campaignRecipients CampaignRecipient[]
  statusHistories    InquiryStatusHistory[]

  @@index([createdAt])
  @@index([sourceDataId])
  @@index([firstProcessedAt])
  @@index([firstInteractedAt])
  @@index([nbAt])
  @@index([teamId])
  @@index([createdById])
  @@map("inquiry")
}

model InquiryStatusHistory {
  id               Int         @id @default(autoincrement())

  inquiryId        Int         @map("inquiry_id")
  inquiry          Inquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  previousStatusId Int?        @map("previous_status_id")
  previousStatus   StatusData? @relation("PreviousStatusHistory", fields: [previousStatusId], references: [id], onDelete: SetNull)

  newStatusId      Int         @map("new_status_id")
  newStatus        StatusData  @relation("NewStatusHistory", fields: [newStatusId], references: [id], onDelete: Restrict)

  changedById      Int?        @map("changed_by_id")
  changedBy        Account?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  teamId           Int?        @map("team_id")
  team             Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)

  notes            String?     @db.Text

  changedAt        DateTime    @default(now()) @map("changed_at") @db.Timestamptz()

  @@index([inquiryId])
  @@index([changedAt])
  @@index([teamId])
  @@index([newStatusId])
  @@index([changedAt, newStatusId])
  @@map("inquiry_status_history")
}

enum EventName {
  TALKSHOW
  LIVESTREAM
  OPEN_DAY
  COFFEE_TALK
  CAMPUS_TOUR
  WORKSHOP
  ONE_ON_ONE_CONSULTATION
}

enum CompensationStatus {
  REPORTED
  COMPENSATED
}
