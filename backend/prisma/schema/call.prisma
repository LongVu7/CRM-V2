// !--- Call and CallDisposition tables ---! //

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  // Lifecycle States (transient)
  INITIATING
  RINGING
  CONNECTED
  ON_HOLD
  // Final Outcomes (terminal)
  COMPLETED
  MISSED
  DECLINED
  FAILED
  DROPPED
  NO_ANSWER
  BUSY
}

enum DispositionCategory {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Call {
  id                Int           @id @default(autoincrement())
  direction         CallDirection
  status            CallStatus    @default(INITIATING)
  callerNumber      String        @map("caller_number") @db.VarChar(20)
  destinationNumber String        @map("destination_number") @db.VarChar(20)
  durationSeconds   Int?          @map("duration_seconds")
  note              String?       @db.Text
  startedAt         DateTime      @map("started_at") @db.Timestamptz()
  answeredAt        DateTime?     @map("answered_at") @db.Timestamptz()
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz()
  finalizedAt       DateTime?     @map("finalized_at") @db.Timestamptz()

  handledById Int     @map("handled_by_id")
  handledBy   Account @relation("CallHandler", fields: [handledById], references: [id])

  studentId Int?     @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  inquiryId Int?     @map("inquiry_id")
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  dispositionId Int?             @map("disposition_id")
  disposition   CallDisposition? @relation(fields: [dispositionId], references: [id])

  correlationId     String  @unique @map("correlation_id") @db.VarChar(100)
  asteriskChannelId String? @map("asterisk_channel_id") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@index([handledById])
  @@index([studentId])
  @@index([inquiryId])
  @@index([startedAt])
  @@index([status])
  @@map("call")
}

model CallDisposition {
  id        Int                 @id @default(autoincrement())
  label     String              @unique @db.VarChar(100)
  category  DispositionCategory
  sortOrder Int                 @default(0) @map("sort_order")
  isActive  Boolean             @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  calls Call[]

  @@map("call_disposition")
}
